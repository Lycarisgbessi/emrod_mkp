# ═══════════════════════════════════════════════════════════════════
# EMROD Marketplace — variables d'environnement
# Copier vers .env.local (dev) / .env (prod). Chargé via dotenv au boot.
#
# ⚠ SECRETS : ce fichier modèle ne contient AUCUNE valeur réelle.
#   Ne jamais committer de credential (ni ici, ni ailleurs dans le repo).
# ═══════════════════════════════════════════════════════════════════

# ── BASE DE DONNÉES (PostgreSQL — Neon ou tout provider PG) ─────────
# OBLIGATOIRE. Chaîne de connexion du pooler Neon, ex :
#   postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# À définir dans .env (gitignored) et dans les variables d'env de l'hébergeur.
# Ne JAMAIS hardcoder cette URL dans le code source : quiconque lit le repo
# pourrait se connecter à la base (y compris en admin).
DATABASE_URL=""
# Taille du pool pg (défaut 5). Neon free tier : laisser 5.
# PG_POOL_MAX=5

# ── OBLIGATOIRE EN PRODUCTION ────────────────────────────────────────
# Secret de signature des sessions JWT et des jetons de suivi.
# Générer : openssl rand -hex 32
# Sans lui, le serveur REFUSE de démarrer en production (NODE_ENV=production).
JWT_SECRET=""

# URL publique où l'app est hébergée (returnUrls Djomy, cookies Secure, sitemap).
APP_URL="https://emroddf.com"

# ── SERVEUR ──────────────────────────────────────────────────────────
PORT=3000
# NODE_ENV=production pour servir dist/ (lancer d'abord `npm run build`)
# NODE_ENV=development
# DISABLE_HMR=true pour désactiver le HMR Vite derrière un tunnel/proxy

# ── PAIEMENT DJOMY (https://developers.djomy.africa) ─────────────────
# Sandbox: https://sandbox-api.djomy.africa | Production: https://api.djomy.africa
# Sans CLIENT_ID/SECRET : simulateur sandbox local (paiements factices).
DJOMY_CLIENT_ID=""
DJOMY_CLIENT_SECRET=""
DJOMY_WEBHOOK_SECRET=""
DJOMY_API_BASE_URL="https://sandbox-api.djomy.africa"

# ── ACCÈS ADMINISTRATEUR ─────────────────────────────────────────────
# Pas de mot de passe admin via env : au premier démarrage, la base est
# « non réclamée » et l'écran « Initialiser l'accès Administrateur » permet
# de définir le mot de passe (haché en base). Définir JWT_SECRET AVANT toute
# exposition publique, sinon un tiers pourrait réclamer l'accès admin.

# ── WEB PUSH (PWA) ───────────────────────────────────────────────────
# Optionnel : si vide, des clés VAPID sont générées et PERSISTÉES en base
# (les abonnements push survivent aux redémarrages).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@emroddf.com"

# ── E-MAILS TRANSACTIONNELS ──────────────────────────────────────────
# Optionnel : confirmation de commande/devis avec le lien de suivi.
# Ex: smtps://utilisateur:motdepasse@smtp.fournisseur.gn:465
# Sans SMTP_URL : le jeton de suivi reste affiché à l'écran uniquement.
# (SMTP_HOST/SMTP_USER servent uniquement au diagnostic « smtpConfigured ».)
SMTP_URL=""
SMTP_FROM="EMROD Marketplace <no-reply@emroddf.com>"

# ── COMPTES DE DÉMONSTRATION (seed, première base uniquement) ────────
# Si vides : mots de passe aléatoires générés et affichés une fois en console.
# SEED_EMROD_ADMIN_PASSWORD=""
# SEED_VENDOR_NIMBA_PASSWORD=""
# SEED_VENDOR_FOUTA_PASSWORD=""

# ── NETTOYAGE DES DONNÉES DE DÉMONSTRATION ───────────────────────────
# "true" au démarrage supprime commandes/avis/devis/notifications démo,
# désactive le virement bancaire fictif d'Atelier Fouta et retire ses produits
# publiés (l'atelier reste en file KYC pour tester la validation admin).
PURGE_DEMO_DATA=""
